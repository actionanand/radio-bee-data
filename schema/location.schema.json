{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/actionanand/radio-bee-data/blob/main/schema/location.schema.json",
  "title": "RadioBee location v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "type",
    "parentId",
    "countryCode"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "country",
        "state",
        "district",
        "locality"
      ]
    },
    "parentId": {
      "type": [
        "string",
        "null"
      ]
    },
    "countryCode": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    }
  }
}
