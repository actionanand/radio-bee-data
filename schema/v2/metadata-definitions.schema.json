{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RadioBee optional station metadata v2",
  "$defs": {
    "languageProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "programmingPattern",
        "coverage",
        "primaryLanguage",
        "sourceIds",
        "reviewedOn",
        "notes"
      ],
      "properties": {
        "classification": {
          "enum": [
            "single-language",
            "multilingual",
            "unknown"
          ]
        },
        "programmingPattern": {
          "enum": [
            "continuous",
            "mixed",
            "scheduled",
            "unknown"
          ]
        },
        "coverage": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        },
        "primaryLanguage": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reviewedOn": {
          "type": "string",
          "format": "date"
        },
        "notes": {
          "type": "string",
          "minLength": 1
        },
        "schedules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/schedule"
          }
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "languages",
        "days",
        "startLocal",
        "endLocal",
        "timeZone",
        "sourceIds",
        "reviewedOn"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "languages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "days": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          }
        },
        "startLocal": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "endLocal": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "timeZone": {
          "type": "string",
          "minLength": 3
        },
        "sourceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "reviewedOn": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "geographyEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confidence",
        "evidenceType",
        "sourceIds",
        "reviewedOn",
        "notes"
      ],
      "properties": {
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        },
        "evidenceType": {
          "enum": [
            "publisher",
            "official",
            "directory-corroborated",
            "user-corroborated",
            "legacy-catalogue",
            "unknown"
          ]
        },
        "sourceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reviewedOn": {
          "type": "string",
          "format": "date"
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
