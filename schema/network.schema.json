{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/actionanand/radio-bee-data/blob/main/schema/network.schema.json",
  "title": "RadioBee network v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "aliases",
    "countryCodes",
    "kind",
    "website"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "countryCodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2}$"
      }
    },
    "kind": {
      "enum": [
        "public",
        "broadcaster",
        "online"
      ]
    },
    "website": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    }
  }
}
